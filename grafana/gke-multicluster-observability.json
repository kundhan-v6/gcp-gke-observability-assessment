      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "application error rate over time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-bigquery-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efz5kdjuqg54wc"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": 0,
                        "location": "US",
                        "project": "gcp-gke-assessment",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  TIMESTAMP_SECONDS(\n    DIV(UNIX_SECONDS(timestamp), 300) * 300\n  ) AS time,\n  CONCAT(\n    resource.labels.cluster_name,\n    ' / ',\n    jsonPayload.app\n  ) AS series,\n  ROUND(\n    100 * SAFE_DIVIDE(\n      COUNTIF(jsonPayload.status >= 500),\n      COUNT(*)\n    ),\n    2\n  ) AS error_rate_pct\nFROM `gcp-gke-assessment.gke_observability.stdout`\nWHERE $__timeFilter(timestamp)\n  AND resource.labels.namespace_name = 'assessment'\n  AND jsonPayload.app IN ('app-a', 'app-b')\nGROUP BY time, series\nORDER BY time, series",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
