      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Request latency — p50, p95 and p99",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-bigquery-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efz5kdjuqg54wc"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": 0,
                        "location": "US",
                        "project": "gcp-gke-assessment",
                        "rawQuery": true,
                        "rawSql": "WITH latency_buckets AS (\n  SELECT\n    TIMESTAMP_SECONDS(\n      DIV(UNIX_SECONDS(timestamp), 300) * 300\n    ) AS time,\n    CONCAT(\n      resource.labels.cluster_name,\n      ' / ',\n      jsonPayload.app\n    ) AS series,\n    APPROX_QUANTILES(jsonPayload.latency_ms, 100) AS percentiles\n  FROM `gcp-gke-assessment.gke_observability.stdout`\n  WHERE $__timeFilter(timestamp)\n    AND resource.labels.namespace_name = 'assessment'\n    AND jsonPayload.app IN ('app-a', 'app-b')\n    AND jsonPayload.latency_ms IS NOT NULL\n  GROUP BY time, series\n)\n\nSELECT\n  time,\n  series,\n  ROUND(percentiles[OFFSET(50)], 2) AS p50_ms,\n  ROUND(percentiles[OFFSET(95)], 2) AS p95_ms,\n  ROUND(percentiles[OFFSET(99)], 2) AS p99_ms\nFROM latency_buckets\nORDER BY time, series",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
